{
  "name": "falcon-drums-api",
  "version": "1.0.0",
  "description": "Cloudflare Worker API for Falcon Drums e-commerce",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:create": "wrangler d1 create falcon-drums-orders",
    "db:migrate:local": "wrangler d1 migrations apply falcon-drums-orders --local",
    "db:migrate:remote": "wrangler d1 migrations apply falcon-drums-orders --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "wrangler": "^3.57.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@paypal/checkout-server-sdk": "^1.0.3"
  }
}
